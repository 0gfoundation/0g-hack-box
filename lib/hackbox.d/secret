#!/usr/bin/env bash
# hackbox-help: set <name> | list | rm <name>  (agent keys, never printed)
# hackbox secret: manage the keys in /etc/hackbox/secrets/ without ever printing them.
#   hackbox secret set <name>    value from stdin (pipe) or a hidden prompt
#   hackbox secret list          names, presence, age; never values
#   hackbox secret rm <name>
# Names: anthropic-api-key, claude-gateway-token, claude-oauth-token, 0g-router-key.
# All four are read at run time by code running as the attendee (apiKeyHelper,
# hackbox-agent, the seed hook's env file), so they are
# root:hacker 0640. That is the documented residual exposure: use per-box keys with
# server-side limits (Console workspace cap, gateway budget, 0G Router credit_limit).
# Run as the admin user (uses sudo). HB_ROOT=/tmp/x works on a temp root without sudo.
set -euo pipefail

NAMES="anthropic-api-key claude-gateway-token claude-oauth-token 0g-router-key"
ROOT=${HB_ROOT:-}
DIR="$ROOT/etc/hackbox/secrets"
if [ -n "$ROOT" ]; then SUDO=(); else SUDO=(sudo); fi
for f in "$ROOT"/etc/hackbox/conf.d/*.conf; do [ -r "$f" ] && . "$f"; done
GROUP=${HACKER_USER:-hacker}

usage() {
  echo "usage: hackbox secret set <name> | list | rm <name>" >&2
  echo "names: $NAMES" >&2
  exit 2
}
check_name() {
  case " $NAMES " in *" ${1:-} "*) ;; *) echo "hackbox secret: unknown name '${1:-}'" >&2; usage ;; esac
}
refresh() {
  # Keep agents.json's readiness flags current. Harmless if not installed yet.
  if [ -n "$ROOT" ]; then
    "$(cd "$(dirname "$0")/../.." && pwd)/files/ai/hackbox-ai-render" current >/dev/null 2>&1 || true
  elif [ -x /usr/local/sbin/hackbox-ai-render ]; then
    sudo /usr/local/sbin/hackbox-ai-render current >/dev/null 2>&1 || true
  fi
}
ensure_dir() {
  if [ -z "$ROOT" ] && ! getent group "$GROUP" >/dev/null; then
    echo "hackbox secret: group $GROUP missing, run setup/60-hacker.sh first" >&2
    exit 1
  fi
  if [ -n "$ROOT" ]; then
    mkdir -p "$DIR"; chmod 0750 "$DIR"
  else
    sudo install -d -m 0750 -o root -g "$GROUP" "$DIR"
  fi
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case "$cmd" in
  set)
    name=${1:-}; check_name "$name"
    if [ -t 0 ]; then
      IFS= read -r -s -p "value for $name (input hidden): " value; echo >&2
    else
      value=$(cat)
    fi
    value=$(printf '%s' "$value" | tr -d ' \t\r\n')
    if [ -z "$value" ]; then
      echo "hackbox secret: empty value, nothing written" >&2
      exit 1
    fi
    ensure_dir
    owner="root:$GROUP"; [ -n "$ROOT" ] && owner=""
    # The value goes through a pipe, never argv, so it is not visible in ps.
    printf '%s' "$value" | "${SUDO[@]}" sh -c '
      set -e; umask 077
      tmp="$1.tmp.$$"
      cat > "$tmp"
      [ -n "$2" ] && chown "$2" "$tmp"
      chmod 0640 "$tmp"
      mv -f "$tmp" "$1"' sh "$DIR/$name" "$owner"
    echo "saved $name (${#value} characters). Takes effect at the next reset."
    unset value
    refresh
    ;;
  list)
    now=$(date +%s)
    printf '%-22s %-8s %-10s %s\n' NAME STATE AGE OWNER/MODE
    for name in $NAMES; do
      f="$DIR/$name"
      if info=$("${SUDO[@]}" stat -c '%Y %s %U:%G %a' "$f" 2>/dev/null); then
        read -r mtime size owner mode <<< "$info"
        age=$(( now - mtime ))
        if [ "$age" -ge 86400 ]; then age="$(( age / 86400 ))d"
        elif [ "$age" -ge 3600 ]; then age="$(( age / 3600 ))h"
        else age="$(( age / 60 ))m"; fi
        state=present; [ "$size" -eq 0 ] && state=empty
        printf '%-22s %-8s %-10s %s\n' "$name" "$state" "$age" "$owner $mode"
      else
        printf '%-22s %-8s %-10s %s\n' "$name" missing - -
      fi
    done
    ;;
  rm)
    name=${1:-}; check_name "$name"
    "${SUDO[@]}" rm -f "$DIR/$name"
    echo "removed $name. Takes effect at the next reset."
    refresh
    ;;
  *) usage ;;
esac
