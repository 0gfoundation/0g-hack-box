# Ubiquity preseed for hackbox machines (Linux Mint 22.3 Cinnamon).
# Shared by the VM lab (install-base.sh) and the USB installer (usb/make-usb-iso.sh).
# Loaded by casper from /preseed.cfg inside an extra initrd segment (see build-initrd.sh).
# Per-install values come from the kernel command line:
#   hb_mode=lab|usb    lab adds ssh keys, passwordless sudo and openssh-server
#   hb_mode=headless   USB stick for a box without a screen (usb/make-usb-iso.sh --headless)
#   hb_host=<name>     hostname (default: hackbox-<last 4 hex of the first NIC MAC>)
#   hb_disk=<dev>      target disk (default: first non-removable nvme/sd/vd disk that is not the boot media)

# Locale and keyboard
d-i debian-installer/locale string en_US.UTF-8
d-i debian-installer/language string en
d-i debian-installer/country string US
d-i localechooser/supported-locales multiselect en_US.UTF-8
d-i console-setup/ask_detect boolean false
d-i keyboard-configuration/layoutcode string us
d-i keyboard-configuration/xkb-keymap select us
d-i keyboard-configuration/modelcode string pc105
d-i keyboard-configuration/variantcode string

# Time
d-i time/zone string Asia/Singapore
d-i clock-setup/utc boolean true
d-i clock-setup/ntp boolean true
ubiquity tzsetup/geoip_server string

# Hostname (late script enforces the final value)
d-i netcfg/get_hostname string hackbox
d-i netcfg/get_domain string
d-i netcfg/hostname string hackbox

# Admin user (the normal user bootstrap.sh runs as)
d-i passwd/user-fullname string Hack Admin
d-i passwd/username string hackadmin
d-i passwd/user-password password hackadmin
d-i passwd/user-password-again password hackadmin
d-i user-setup/allow-password-weak boolean true
d-i user-setup/encrypt-home boolean false
d-i passwd/auto-login boolean false

# Whole-disk automatic partitioning (UEFI: ESP + ext4 root, swapfile)
# partman-auto/disk is set by hackbox-early.sh
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-md/confirm boolean true
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i partman-efi/non_efi_system boolean true
d-i partman/unmount_active boolean true

# Bootloader. Do NOT preseed grub-installer/force-efi-extra-removable: Ubuntu's grub-install has
# no --force-extra-removable option and the install fails. hackbox-late.sh writes the removable
# path EFI/BOOT/BOOTX64.EFI instead, so the disk boots even if firmware boot entries are lost.
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean false

# Ubiquity behaviour: no third-party codecs, no updates during install, reboot at the end
ubiquity ubiquity/use_nonfree boolean false
ubiquity ubiquity/download_updates boolean false
ubiquity ubiquity/reboot boolean true
ubiquity ubiquity/summary note
ubiquity languagechooser/language-name select English
ubiquity countrychooser/shortlist select US

# Early: pick the target disk, stage the late script. Late: hostname, timezone, lab access.
d-i preseed/early_command string sh /hackbox-early.sh
ubiquity ubiquity/success_command string sh /usr/local/sbin/hackbox-late.sh
