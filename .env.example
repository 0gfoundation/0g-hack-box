# hack-box build settings: one file for every secret. Copy to .env (git ignored), fill in,
# chmod 600. Then build one stick for every box (the hub numbers them):
#   usb/make-usb-iso.sh --headless --config .env --fleet --repo "$PWD" \
#       linuxmint-22.3-cinnamon-64bit.iso ~/hackbox-fleet.iso
# (or --host hackbox2 for a stick that always installs hackbox2 with HUB_TOKEN_hackbox2)
# This is a shell file. Quote values with single quotes; a ' inside a value is '\''.
# The ISO carries the Wi-Fi password, the Tailscale key, the hub token and the admin password
# hash: keep the ISO and the stick private and re-flash the stick after the event.
# Every key is explained in usb/headless.conf.example; only the ones we use are listed here.

# --- box ---------------------------------------------------------------------------------
# Default hostname; --host overrides it per stick.
HB_HOSTNAME='hackbox1'
ADMIN_USER='hackadmin'
# Plain password (hashed at build time, never stored in clear on the stick) or a ready hash.
ADMIN_PASSWORD=''
ADMIN_PASSWORD_HASH=''

# --- network -----------------------------------------------------------------------------
# Copy the SSID byte for byte. An iPhone hotspot uses a curly apostrophe: Udhaykumar’s iPhone
# (read it with `ipconfig getsummary en0` on a Mac joined to it). A cable always wins.
WIFI_SSID=''
WIFI_PASSWORD=''
WIFI_COUNTRY='SG'

# --- access ------------------------------------------------------------------------------
# Public keys allowed to ssh in as the admin. Use a dedicated key without a passphrase, so
# scripts can log in without an agent:  ssh-keygen -t ed25519 -N '' -f ~/.ssh/hackbox_ed25519
SSH_KEY_FILES="$HOME/.ssh/hackbox_ed25519.pub $HOME/.ssh/id_ed25519.pub"
# Tailscale auth key (pre-approved, reusable for a fleet). The box joins as its hostname.
TS_AUTHKEY=''
TS_TAG=''

# --- session hub (hub/, docs/superpowers/specs/2026-10-01-session-hub-design.md) -----------
# Tailnet address of the hub and one token per box (from the hub's config.json; a - in the
# hostname is written as _). Leave HUB_URL empty for a box without a hub.
HUB_URL='http://100.113.49.48:8210'
HUB_TOKEN_hackbox1=''
HUB_TOKEN_hackbox2=''
HUB_TOKEN_hackbox3=''
HUB_TOKEN_hackbox4=''
# Fleet stick (make-usb-iso.sh --fleet): one stick for every box; the hub gives each box the
# next free name and its own token on the first boot. Same value as enroll_token in the
# hub's config.json.
HUB_ENROLL_TOKEN=''
# Agent keys (Anthropic, 0G router) are set on the hub dashboard, not here.

# --- build -------------------------------------------------------------------------------
REPO_DIR="$HOME/0g-hack-box"
