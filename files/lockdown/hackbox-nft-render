#!/usr/bin/env bash
# Print the attendee firewall (table inet hackbox) on stdout. setup/80-lockdown.sh writes
# it to /etc/hackbox/hackbox.nft, which hackbox-nft.service loads with `nft -f`.
#
# Rules of the road:
# - Only table inet hackbox is created or deleted. Never `flush ruleset`, never
#   /etc/nftables.conf: Tailscale's own tables must survive.
# - Egress is filtered only for sockets owned by the attendee uid. `meta skuid N jump`
#   (not `meta skuid != N accept`) because packets with no full socket (kernel made
#   SYN-ACKs, ICMP replies, RSTs) do not match skuid at all; with a negative match they
#   would fall through into the attendee rules and break ssh over the tailnet.
# - The attendee is rejected, not dropped, so curl, npm and git fail in milliseconds.
# - Inbound (all users): loopback, tailnet, established, ICMP, DHCP and tailscaled's
#   WireGuard port; anything else new is dropped so the venue LAN cannot reach an
#   attendee's dev server or the box's sshd.
#
# Inputs (environment, normally from /etc/hackbox/conf.d): HACKER_UID, NFT_ALLOW4,
# NFT_INBOUND_TCP, TS_UDP_PORT.
set -euo pipefail

uid=${HACKER_UID:-2000}
case "$uid" in ''|*[!0-9]*) echo "HACKER_UID must be a number" >&2; exit 1 ;; esac
ts_port=${TS_UDP_PORT:-41641}
case "$ts_port" in ''|*[!0-9]*) echo "TS_UDP_PORT must be a number" >&2; exit 1 ;; esac

allow4=$(echo ${NFT_ALLOW4:-} | tr ' ' ',')
inbound_tcp=$(echo ${NFT_INBOUND_TCP:-} | tr ' ' ',')
for x in ${NFT_ALLOW4:-}; do
  case "$x" in *[!0-9./]*) echo "NFT_ALLOW4 entry '$x' is not an IPv4 address or CIDR" >&2; exit 1 ;; esac
done
for x in ${NFT_INBOUND_TCP:-}; do
  case "$x" in *[!0-9]*) echo "NFT_INBOUND_TCP entry '$x' is not a port number" >&2; exit 1 ;; esac
done

cat <<EOF
#!/usr/sbin/nft -f
# hack-box attendee firewall. Generated by hackbox-nft-render from /etc/hackbox/conf.d;
# edit the conf and rerun setup/80-lockdown.sh instead of this file.
# Owns only table inet hackbox. The empty declaration plus delete makes a reload atomic
# and idempotent whether or not the table already exists.

table inet hackbox
delete table inet hackbox

table inet hackbox {
	# IPv4 default gateway(s), filled at runtime by the NetworkManager dispatcher script
	# /etc/NetworkManager/dispatcher.d/90-hackbox-gw, for DNS queries sent straight to it.
	set lan_gw4 {
		type ipv4_addr
	}

	# Organiser exceptions to the private range block (NFT_ALLOW4).
	set allow4 {
		type ipv4_addr
		flags interval
EOF
if [ -n "$allow4" ]; then
  printf '\t\telements = { %s }\n' "$allow4"
fi
cat <<EOF
	}

	# 0.0.0.0/8 this network; 10/8, 172.16/12, 192.168/16 RFC1918; 100.64/10 CGNAT and
	# the tailnet (100.100.100.100 included); 169.254/16 link-local and cloud metadata;
	# 192.0.0/24 IETF; 198.18/15 benchmarking; 224/4 multicast; 240/4 reserved.
	set blocked4 {
		type ipv4_addr
		flags interval
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 169.254.0.0/16,
			     172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15,
			     224.0.0.0/4, 240.0.0.0/4 }
	}

	# fc00::/7 ULA (includes the tailnet fd7a:115c:a1e0::/48); fe80::/10 link-local;
	# ff00::/8 multicast.
	set blocked6 {
		type ipv6_addr
		flags interval
		elements = { fc00::/7, fe80::/10, ff00::/8 }
	}

	chain attendee {
		# the attendee's own dev servers and the resolved stub at 127.0.0.53
		oifname "lo" accept
		oifname "tailscale0" counter reject with icmpx admin-prohibited
		ip daddr @lan_gw4 meta l4proto { tcp, udp } th dport 53 accept
		ip daddr @allow4 accept
		ip daddr @blocked4 counter reject with icmpx admin-prohibited
		ip6 daddr @blocked6 counter reject with icmpx admin-prohibited
		# everything else is the public internet: accepted by the base chain policy
	}

	chain output {
		type filter hook output priority filter; policy accept;
		meta skuid $uid jump attendee
	}

	chain input {
		type filter hook input priority filter; policy accept;
		iifname "lo" accept
		iifname "tailscale0" accept
		ct state established,related accept
		ct state invalid drop
		meta l4proto { icmp, ipv6-icmp } accept
		# DHCPv4 and DHCPv6 client replies
		udp dport { 68, 546 } accept
		# tailscaled WireGuard, so direct peer paths work instead of relays
		udp dport $ts_port accept
EOF
if [ -n "$inbound_tcp" ]; then
  printf '\t\t# NFT_INBOUND_TCP\n\t\ttcp dport { %s } accept\n' "$inbound_tcp"
fi
cat <<'EOF'
		counter drop
	}
}
EOF
