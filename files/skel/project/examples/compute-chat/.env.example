# 0G Compute Router (OpenAI-compatible). Mainnet router, billed in 0G from the key's deposit.
OG_ROUTER_URL=https://router-api.0g.ai
# On the hack box a credit-limited key is provided for you; leave this empty to use it.
# To use your own key: pc.0g.ai > Dashboard > API Keys (starts with sk-).
ZG_ROUTER_API_KEY=
# Any model id from `npm run models`
OG_MODEL=glm-5.3
