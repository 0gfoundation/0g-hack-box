[Unit]
Description=hack-box mock API for builders (fake prices, markets, AI marketplace) on 127.0.0.1:4010
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/0g-mock-api --host 127.0.0.1 --port 4010
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
