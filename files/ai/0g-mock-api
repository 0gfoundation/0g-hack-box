def portfolio(q):
    addr = (q.get("address") or ["0x0000000000000000000000000000000000000000"])[0]
    t = time.time()
    hold = []
    for s in ("0G", "ETH", "BTC", "USDC", "SOL", "LINK"):
        k = seed_float(addr.lower(), s)
