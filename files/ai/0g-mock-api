STABLE = {"USDC", "USDT"}


def seed_float(*parts):
    h = hashlib.sha256("|".join(str(p) for p in parts).encode()).digest()
    return int.from_bytes(h[:8], "big") / 2.0 ** 64


def price_at(sym, t):
    """A smooth, deterministic walk around the base price: the same for every caller."""
    base = ASSETS.get(sym, 1.0 + seed_float(sym) * 50)
    if sym in STABLE:
        return round(base + (seed_float(sym, int(t // 60)) - 0.5) * 0.002, 4)
    k = seed_float(sym)
    wave = (0.06 * math.sin(t / (3600 * (2 + 3 * k))) + 0.02 * math.sin(t / (300 * (1 + k)))
            + 0.006 * math.sin(t / (23 * (1 + k))))
    step = int(t // 5)
    jitter = (seed_float(sym, step) - 0.5) * 0.004
    return base * (1 + wave + jitter)


def rnd(x):
    if x >= 1000:
        return round(x, 2)
    if x >= 1:
        return round(x, 4)
    return float("%.6g" % x)


def sym_of(q, default="ETH"):
    s = (q.get("symbol") or [default])[0].upper().replace("-USD", "").replace("/USD", "")
    return s.replace("USDT", "") if s not in STABLE and s.endswith("USDT") else s


def num(q, key, default, lo, hi):
    try:
        return max(lo, min(hi, int((q.get(key) or [default])[0])))
    except ValueError:
        return default


def prices(q):
    t = time.time()
    syms = [s.strip().upper() for s in (q.get("symbols") or [",".join(ASSETS)])[0].split(",") if s.strip()]
    out = []
    for s in syms:
        p, p24 = price_at(s, t), price_at(s, t - 86400)
        out.append({"symbol": s, "price_usd": rnd(p), "change_24h_pct": round((p / p24 - 1) * 100, 2),
                    "volume_24h_usd": round(5e6 + seed_float(s, "vol") * 9e8, 0),
                    "market_cap_usd": round(p * (1e8 + seed_float(s, "cap") * 2e10), 0)})
    return {"prices": out, "updated_at": int(t)}


INTERVALS = {"1m": 60, "5m": 300, "15m": 900, "1h": 3600, "4h": 14400, "1d": 86400}


def candles(q):
    s = sym_of(q)
    iv = (q.get("interval") or ["1h"])[0]
    sec = INTERVALS.get(iv, 3600)
    n = num(q, "limit", 100, 1, 500)
    end = int(time.time() // sec) * sec
    out = []
    for i in range(n, 0, -1):
        t0 = end - i * sec
        o, c = price_at(s, t0), price_at(s, t0 + sec)
        hi = max(o, c) * (1 + seed_float(s, t0, "h") * 0.004)
        lo = min(o, c) * (1 - seed_float(s, t0, "l") * 0.004)
        out.append({"t": t0, "open": rnd(o), "high": rnd(hi), "low": rnd(lo), "close": rnd(c),
                    "volume": round(10 + seed_float(s, t0, "v") * 900, 3)})
    return {"symbol": s, "interval": iv if iv in INTERVALS else "1h", "candles": out}


def orderbook(q):
    s = sym_of(q)
    depth = num(q, "depth", 15, 1, 100)
    t = time.time()
    mid = price_at(s, t)
    r = random.Random(int(t // 2))
    tick = mid * 0.0004
    bids = [[rnd(mid - tick * (i + 1)), round(r.uniform(0.05, 12), 4)] for i in range(depth)]
    asks = [[rnd(mid + tick * (i + 1)), round(r.uniform(0.05, 12), 4)] for i in range(depth)]
    return {"symbol": s, "mid": rnd(mid), "bids": bids, "asks": asks, "updated_at": int(t)}


def trades(q):
    s = sym_of(q)
    n = num(q, "limit", 30, 1, 200)
    t = time.time()
    r = random.Random(int(t))
    out = []
    for i in range(n):
        ts = t - i * r.uniform(0.5, 4)
        out.append({"id": "%s-%d" % (s, int(ts * 1000)), "price": rnd(price_at(s, ts)),
                    "size": round(r.uniform(0.01, 5), 4), "side": r.choice(["buy", "sell"]),
                    "time": int(ts)})
    return {"symbol": s, "trades": out}


def markets(q):
    t = time.time()
    out = []
    for s in ASSETS:
        if s in STABLE:
            continue
        p, p24 = price_at(s, t), price_at(s, t - 86400)
        out.append({"pair": s + "/USDC", "base": s, "quote": "USDC", "price": rnd(p),
                    "change_24h_pct": round((p / p24 - 1) * 100, 2),
                    "high_24h": rnd(max(p, p24) * 1.01), "low_24h": rnd(min(p, p24) * 0.99),
                    "volume_24h_usd": round(5e6 + seed_float(s, "vol") * 9e8, 0)})
    return {"markets": out}


