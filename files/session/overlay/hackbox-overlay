def load_conf():
    """Source /etc/hackbox/conf.d the same way the shell helpers do."""
    # EVENT_TITLE and EVENT_LINE brand the screens (override in conf.d/90-local.conf).
    conf = {"SESSION_MINUTES": "30", "WARN_MINUTES": "5 1",
            "END_GRACE_SECONDS": "20", "ARCHIVE_HOURS": "24", "HUB_ENABLED": "0",
            "EVENT_TITLE": "DEV DAY", "EVENT_LINE": "05 OCT . 2026 . SINGAPORE",
            # REWARD_TEXT: shown on the welcome and time-up screens when set.
            # START_URL: opened next to the agent's terminal (right half) when a session starts.
            "REWARD_TEXT": "", "START_URL": ""}
    script = ('for f in /etc/hackbox/conf.d/*.conf; do [ -r "$f" ] && . "$f"; done; '
              'printf "%s\\n" "$SESSION_MINUTES" "$WARN_MINUTES" "$END_GRACE_SECONDS" "$ARCHIVE_HOURS" '
              '"$HUB_ENABLED" "$EVENT_TITLE" "$EVENT_LINE" "$REWARD_TEXT" "$START_URL"')
    try:
        out = subprocess.run(["bash", "-c", script], capture_output=True, text=True,
                             timeout=5, env={"PATH": "/usr/bin:/bin"}).stdout.split("\n")
        for key, val in zip(("SESSION_MINUTES", "WARN_MINUTES", "END_GRACE_SECONDS",
                             "ARCHIVE_HOURS", "HUB_ENABLED", "EVENT_TITLE", "EVENT_LINE",
                             "REWARD_TEXT", "START_URL"), out):
            if val.strip():
                conf[key] = val.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return conf


def as_int(value, default):
    try:
        return int(str(value).strip())
    except (TypeError, ValueError):
        return default


def load_agents():
    """Entries from agents.json (SPEC 3.7). Empty list means generic mode."""
    try:
        with open(AGENTS_FILE, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return []
    agents = []
    if not isinstance(data, list):
        return []
    for entry in data:
        if not isinstance(entry, dict):
            continue
        label, command = entry.get("label"), entry.get("command")
        if not isinstance(label, str) or not isinstance(command, str):
            continue
        if not label.strip() or not command.strip():
            continue
        note = entry.get("note") if isinstance(entry.get("note"), str) else ""
        agents.append({"id": str(entry.get("id", label)), "label": label.strip(),
                       "command": command.strip(), "note": note.strip(),
                       # false when the box has no key for it yet (hackbox-ai-render)
                       "ready": entry.get("ready", True) is not False})
    return agents


def read_run(name):
    try:
        with open(os.path.join(RUN, name), encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return None


def read_run_int(name):
    return as_int(read_run(name), None)


# -------------------------------------------------------------- actions ---

def start_unit(unit, done):
    """systemctl start --no-block <unit> in a thread; done(ok, message) on
    the GTK main loop. The polkit rule decides; nothing here is trusted."""
    def work():
        try:
            r = subprocess.run(["systemctl", "start", "--no-block", unit],
                               capture_output=True, text=True, timeout=20)
            ok, msg = r.returncode == 0, (r.stderr or r.stdout).strip()
        except (OSError, subprocess.SubprocessError) as e:
            ok, msg = False, str(e)
        GLib.idle_add(done, ok, msg)
    threading.Thread(target=work, daemon=True).start()


def save_attendee(name, agent_id, email="", telegram=""):
    """Name and agent for the hub agent, which reads this file as root with
    care (no symlinks, small, owned by the attendee). The home is wiped at
    every reset, so it cannot leak into the next session."""
    path = os.path.join(HOME, ".cache", "hackbox", "attendee")
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(name[:40] + "\n" + agent_id[:30] + "\n" + email[:120] + "\n" +
                    telegram[:33] + "\n")
        os.replace(tmp, path)
    except OSError:
        pass


def open_terminal(agent=None, url=""):
    """A terminal in ~/project, running the agent if given, else a shell. With a URL the
    terminal takes the left half of the screen and Firefox the right half."""
    os.makedirs(PROJECT, exist_ok=True)
    if agent:
        inner = ["bash", "-lc", AGENT_WRAPPER, "hackbox-agent", agent["command"], agent["label"]]
    else:
        inner = ["bash", "-l"]
    side = bool(url) and shutil.which("firefox") and shutil.which("wmctrl")
    if shutil.which("gnome-terminal"):
        argv = ["gnome-terminal", "--working-directory=" + PROJECT] + \
               ([] if side else ["--maximize"]) + ["--"] + inner
    elif shutil.which("x-terminal-emulator"):
        argv = ["x-terminal-emulator", "-e"] + inner
    else:
        return False
    try:
        subprocess.Popen(argv, cwd=PROJECT, start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
        if side:
            subprocess.Popen(["firefox", "--new-window", url], cwd=HOME, start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
            threading.Thread(target=tile_side_by_side, daemon=True).start()
        return True
    except OSError:
        return False


def tile_side_by_side():
    """Put the terminal on the left half and Firefox on the right half, once both windows
    exist (up to 30 s). Best effort: if anything is missing, the windows stay as opened."""
    # Not GTK (this runs in a thread): the work area from the window manager, which also
    # leaves out the bottom panel. "0  * DG: ...  VP: 0,0  WA: 0,0 1920x1040  Workspace 1"
    area = None
    for _ in range(20):
        try:
            d = subprocess.run(["wmctrl", "-d"], capture_output=True, text=True, timeout=5).stdout
        except (OSError, subprocess.SubprocessError):
            return
        m = re.search(r"^\S+\s+\*.*WA: (\d+),(\d+) (\d+)x(\d+)", d, re.M)
        if m:
            area = [int(v) for v in m.groups()]
            break
        time.sleep(0.5)
    if not area:
        return
    ax, ay, aw, ah = area
    half = aw // 2
    want = {"gnome-terminal": ax, "firefox": ax + half}
    done = set()
    for _ in range(60):
        try:
            out = subprocess.run(["wmctrl", "-lx"], capture_output=True, text=True,
                                 timeout=5).stdout
        except (OSError, subprocess.SubprocessError):
            return
        for line in out.splitlines():
            parts = line.split(None, 3)
            if len(parts) < 3:
                continue
            wid, wclass = parts[0], parts[2].lower()
            for key, x in want.items():
                if key in wclass and key not in done:
                    subprocess.run(["wmctrl", "-i", "-r", wid, "-b",
                                    "remove,maximized_vert,maximized_horz"], timeout=5)
                    subprocess.run(["wmctrl", "-i", "-r", wid, "-e",
                                    "0,%d,%d,%d,%d" % (x, ay, half, ah)], timeout=5)
                    done.add(key)
        if len(done) == len(want):
            return
        time.sleep(0.5)


def apply_terminal_profile():
    """Load the skeleton's gnome-terminal profile once per fresh home."""
    marker = os.path.join(HOME, ".cache", "hackbox", "terminal-profile-applied")
    if os.path.exists(marker) or not os.path.exists(TERMINAL_PROFILE) or not shutil.which("dconf"):
        return
    try:
        with open(TERMINAL_PROFILE, "rb") as f:
            subprocess.run(["dconf", "load", TERMINAL_PROFILE_PATH], stdin=f,
                           timeout=10, check=False,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        os.makedirs(os.path.dirname(marker), exist_ok=True)
        open(marker, "w").close()
    except (OSError, subprocess.SubprocessError):
        pass


