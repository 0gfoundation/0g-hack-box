def scale_factor():
    """Type grows with the primary monitor's logical height, so a 4K screen
    at scale 1 gets the same physical size as 1080p (at scale 2 GTK already
    doubles everything and this stays 1)."""
    display = Gdk.Display.get_default()
    mon = display.get_primary_monitor() or display.get_monitor(0)
    if mon is None:
        return 1.0
    h = mon.get_geometry().height
    return max(0.8, min(3.0, h / 1080.0))


def install_css(provider):
    f = scale_factor()
    sizes = {"event": 70, "line": 22, "title": 34, "body": 21, "small": 16, "tiny": 12,
             "code": 64, "button": 21, "bpad_v": 13, "bpad_h": 30, "pill": 22, "pillbtn": 15,
             "toast": 30, "cardpad": 28, "fpad_v": 10, "fpad_h": 16, "qrpad": 14}
    css = CSS_TEMPLATE
    for key, px in sizes.items():
        css = css.replace("{" + key + "}", str(int(round(px * f))))
    try:
        provider.load_from_data(css.encode())
    except GLib.Error:
        # A property this GTK does not know must not take the overlay down.
        css = "\n".join(l for l in css.split("\n") if "letter-spacing" not in l)
        try:
            provider.load_from_data(css.encode())
        except GLib.Error:
            pass


def primary_geometry():
    display = Gdk.Display.get_default()
    mon = display.get_primary_monitor() or display.get_monitor(0)
    return mon.get_geometry()


def label(text="", css=None, wrap=False, xalign=0.5):
    w = Gtk.Label(label=text)
    w.set_xalign(xalign)
    w.set_justify(Gtk.Justification.CENTER)
    if wrap:
        w.set_line_wrap(True)
        w.set_max_width_chars(70)
    if css:
        w.get_style_context().add_class(css)
    return w


