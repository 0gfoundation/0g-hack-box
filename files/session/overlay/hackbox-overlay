class Overlay:
    def __init__(self):
        self.conf = load_conf()
        self.hub = self.conf.get("HUB_ENABLED") == "1"
        self.agents = load_agents()
        self.provider = Gtk.CssProvider()
        install_css(self.provider)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), self.provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Gdk.Screen.get_default().connect("monitors-changed", self._monitors_changed)
        self.full = FullScreen(self)
        self.pill = Pill(self)
        self.toast = Toast()
        self.last_state = None
        self.we_started = False
        self.pending_agent = None
        self.start_deadline = 0
        self.last_warn = read_run("warn")     # do not replay an old warning

    def _monitors_changed(self, *_):
        install_css(self.provider)
        if self.full.get_visible():
            geo = primary_geometry()
            self.full.move(geo.x, geo.y)
            self.full.resize(geo.width, geo.height)

    def begin(self, agent):
        """Start button: ask systemd for the timer, then open the terminal."""
        self.full.set_busy(True, "")
        if self.hub:
            save_attendee(self.full.attendee_name(), agent["id"] if agent else "",
                          self.full.attendee_email(), self.full.attendee_telegram())
        self.we_started = True
        self.pending_agent = agent
        self.start_deadline = time.time() + 15

        def done(ok, msg):
            if not ok:
                self.we_started = False
                self.pending_agent = None
                self.full.set_busy(False, "Could not start the session (%s). "
                                          "Please ask a staff member." % (msg or "no reason given"))
            return False
        start_unit("hackbox-session.service", done)

    def tick(self):
        state = read_run("state") or "idle"
        if state == "active":
            end = read_run_int("session-end")
            if end is None:
                return True
            if self.last_state != "active":
                self.full.hide()
                self.full.set_busy(False, "")
                # Our button: open the chosen agent. Staff `hackbox start`:
                # a plain terminal, so the attendee is not left guessing.
                if self.we_started or self.last_state == "idle":
                    open_terminal(self.pending_agent)
                self.we_started = False
                self.pending_agent = None
            self.pill.update(max(0, end - int(time.time())))
            self.pill.update_request()
            self._check_warning()
        elif state in ("ending", "resetting"):
            self.pill.hide_all()
            self.toast.hide()
            self.full.show_face("ending" if state == "ending" else "resetting")
        else:
            self.pill.hide_all()
            self.toast.hide()
            if self.we_started and time.time() > self.start_deadline:
                self.we_started = False
                self.pending_agent = None
                self.full.set_busy(False, "The session did not start. Please ask a staff member.")
            self.full.show_face("welcome")
        self.last_state = state
        return True

    def _check_warning(self):
        warn = read_run("warn")
        if not warn or warn == self.last_warn:
            return
        self.last_warn = warn
        parts = warn.split()
        minutes = as_int(parts[0], None) if parts else None
        stamp = as_int(parts[1], 0) if len(parts) > 1 else 0
        if minutes is not None and time.time() - stamp < 60:
            self.toast.flash(minutes)


def single_instance():
    """One overlay per session. The lock dies with the process."""
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    path = os.path.join(runtime, "hackbox-overlay.lock")
    try:
        fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return fd
    except OSError:
        return None


def main():
    lock = single_instance()
    if lock is None:
        return 0
    if Gdk.Display.get_default() is None:
        Gtk.init_check(sys.argv)
    if Gdk.Display.get_default() is None:
        print("hackbox-overlay: no display", file=sys.stderr)
        return 1
    apply_terminal_profile()
    app = Overlay()
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, Gtk.main_quit)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, Gtk.main_quit)
    app.tick()
    GLib.timeout_add(500, app.tick)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
