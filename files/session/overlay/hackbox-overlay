def scale_factor():
    """Type grows with the primary monitor's logical height, so a 4K screen
    at scale 1 gets the same physical size as 1080p (at scale 2 GTK already
    doubles everything and this stays 1)."""
    display = Gdk.Display.get_default()
    mon = display.get_primary_monitor() or display.get_monitor(0)
    if mon is None:
        return 1.0
    h = mon.get_geometry().height
    return max(0.8, min(3.0, h / 1080.0))


def install_css(provider):
    f = scale_factor()
    sizes = {"event": 70, "line": 22, "title": 34, "body": 21, "small": 16, "tiny": 12,
             "code": 64, "button": 21, "bpad_v": 13, "bpad_h": 30, "pill": 22, "pillbtn": 15,
             "toast": 30, "cardpad": 28, "fpad_v": 10, "fpad_h": 16, "qrpad": 14}
    css = CSS_TEMPLATE
    for key, px in sizes.items():
        css = css.replace("{" + key + "}", str(int(round(px * f))))
    try:
        provider.load_from_data(css.encode())
    except GLib.Error:
        # A property this GTK does not know must not take the overlay down.
        css = "\n".join(l for l in css.split("\n") if "letter-spacing" not in l)
        try:
            provider.load_from_data(css.encode())
        except GLib.Error:
            pass


def primary_geometry():
    display = Gdk.Display.get_default()
    mon = display.get_primary_monitor() or display.get_monitor(0)
    return mon.get_geometry()


def label(text="", css=None, wrap=False, xalign=0.5):
    w = Gtk.Label(label=text)
    w.set_xalign(xalign)
    w.set_justify(Gtk.Justification.CENTER)
    if wrap:
        w.set_line_wrap(True)
        w.set_max_width_chars(70)
    if css:
        w.get_style_context().add_class(css)
    return w


# The 0G mark, drawn as SVG (a ring with a slash, and a G), white on the gradient.
LOGO_SVG = """<svg xmlns="http://www.w3.org/2000/svg" viewBox="-4 -4 232 108">
<g fill="none" stroke="#ffffff" stroke-width="21">
<circle cx="50" cy="50" r="39.5"/>
<path d="M 189.4 24.6 A 39.5 39.5 0 1 0 199.5 50"/>
</g>
<path d="M 160 50 H 210" stroke="#ffffff" stroke-width="21"/>
<path d="M 26 78 L 58 42" stroke="#ffffff" stroke-width="13" stroke-linecap="butt"/>
</svg>"""


def logo(height):
    loader = GdkPixbuf.PixbufLoader()
    try:
        loader.set_size(int(height * 232 / 108), int(height))
        loader.write(LOGO_SVG.encode())
        loader.close()
        return Gtk.Image.new_from_pixbuf(loader.get_pixbuf())
    except GLib.Error:
        return label("0G", "hb-event")       # no SVG loader: plain text


def lockup(conf, scale=1.0):
    """0G mark next to the event title (two lines), then the date line."""
    f = scale_factor() * scale
    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=int(28 * f))
    row.set_halign(Gtk.Align.CENTER)
    row.pack_start(logo(118 * f), False, False, 0)
    words = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
    words.set_valign(Gtk.Align.CENTER)
    for w in (conf.get("EVENT_TITLE") or "").split()[:2]:
        t = label(w, "hb-event", xalign=0.0)
        if scale != 1.0:
            t.set_markup('<span size="%d">%s</span>' % (int(70 * f * 1024 * 0.75), GLib.markup_escape_text(w)))
        words.pack_start(t, False, False, 0)
    row.pack_start(words, False, False, 0)
    col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=int(18 * f))
    col.set_halign(Gtk.Align.CENTER)
    col.pack_start(row, False, False, 0)
    if conf.get("EVENT_LINE"):
        col.pack_start(label(conf["EVENT_LINE"], "hb-line"), False, False, 0)
    bar = Gtk.Box()
    bar.get_style_context().add_class("hb-rulebar")
    bar.set_size_request(int(150 * scale_factor()), 1)
    bar.set_halign(Gtk.Align.CENTER)
    col.pack_start(bar, False, False, int(8 * f))
    return col


def field(title, entry):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    box.pack_start(label(title, "hb-flabel", xalign=0.0), False, False, 0)
    box.pack_start(entry, False, False, 0)
    return box


def make_entry(placeholder, max_len, on_change):
    e = Gtk.Entry()
    e.set_placeholder_text(placeholder)
    e.set_max_length(max_len)
    e.get_style_context().add_class("hb-name")
    e.connect("changed", lambda *_: on_change())
    return e


# -------------------------------------------------------------- windows ---

class FullScreen(Gtk.Window):
    """Welcome, time-up and resetting faces. Covers the primary monitor."""

    def __init__(self, app):
        super().__init__(title="hack-box")
        self.app = app
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.stick()
        self.get_style_context().add_class("hb-full")
        self.connect("delete-event", lambda *_: True)   # Alt+F4 does nothing
        self.busy = False
        self.qr_shown = None
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.NONE)
        self.add(self.stack)
        self.stack.add_named(self._build_welcome(), "welcome")
        self.stack.add_named(self._build_ending(), "ending")
        self.stack.add_named(self._build_resetting(), "resetting")
        self.face = None

    def _column(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.set_halign(Gtk.Align.CENTER)
        box.set_valign(Gtk.Align.CENTER)
        return box

    def _build_welcome(self):
        conf = self.app.conf
        minutes = as_int(conf["SESSION_MINUTES"], 30)
        box = self._column()
        box.set_spacing(int(16 * scale_factor()))
        box.pack_start(lockup(conf), False, False, 0)
        box.pack_start(label("Build something on 0G in %d minutes." % minutes, "hb-title"),
                       False, False, 0)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=int(14 * scale_factor()))
        card.get_style_context().add_class("hb-card")
        card.set_halign(Gtk.Align.CENTER)
        card.set_size_request(int(600 * scale_factor()), -1)

        # With a hub: who is building, for the history and the download page.
        self.name_entry = self.email_entry = self.telegram_entry = None
        if self.app.hub:
            self.name_entry = make_entry("Ada Lovelace", 40, self._name_changed)
            self.email_entry = make_entry("you@example.com", 120, self._name_changed)
            self.email_entry.set_input_purpose(Gtk.InputPurpose.EMAIL)
            self.telegram_entry = make_entry("@username", 33, self._name_changed)
            # Labels above the fields: a focused entry hides its placeholder.
            card.pack_start(field("NAME", self.name_entry), False, False, 0)
            card.pack_start(field("EMAIL", self.email_entry), False, False, 0)
            card.pack_start(field("TELEGRAM  (OPTIONAL)", self.telegram_entry), False, False, 0)

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        buttons.set_homogeneous(True)
        self.start_buttons = []
        agents = self.app.agents
        if agents:
            for agent in agents:
                note = agent["note"] if agent["ready"] else "not ready yet, ask staff"
                buttons.pack_start(self._start_button("Start with " + agent["label"], note, agent),
                                   True, True, 0)
        else:
            buttons.pack_start(self._start_button("Start my session", "", None), True, True, 0)
        card.pack_start(buttons, False, False, 6)
        self.welcome_error = label("", "hb-error", wrap=True)
        self.welcome_error.set_no_show_all(True)
        card.pack_start(self.welcome_error, False, False, 0)
        box.pack_start(card, False, False, 0)

        rules = "The clock starts when you press Start; when time is up this machine is wiped."
        if self.app.hub:
            rules += "\nYou get a QR code to download your project at the end."
        rules += "\nNever enter personal passwords, wallet seeds or private keys here."
        box.pack_start(label(rules, "hb-muted", wrap=True), False, False, 0)
        box.pack_start(label(socket.gethostname().upper(), "hb-tiny"), False, False, 4)
        self._name_changed()
        return box

    def attendee_name(self):
        if self.name_entry is None:
            return ""
        return " ".join(self.name_entry.get_text().split())

    def attendee_email(self):
        if self.email_entry is None:
            return ""
        return self.email_entry.get_text().strip()

    def attendee_telegram(self):
        if self.telegram_entry is None:
            return ""
        t = self.telegram_entry.get_text().strip().lstrip("@")
        return "@" + t if re.fullmatch(r"[A-Za-z0-9_]{5,32}", t) else ""

    def _name_changed(self):
        """Start stays disabled until a name (2+ characters) and an email are typed, and for
        an agent the box has no key for."""
        ok = self.name_entry is None or (
            len(self.attendee_name()) >= 2 and
            re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", self.attendee_email()) is not None)
        tg = self.telegram_entry.get_text().strip().lstrip("@") if self.telegram_entry else ""
        if tg and not re.fullmatch(r"[A-Za-z0-9_]{5,32}", tg):
            ok = False                          # optional, but if typed it must be valid
        for b in self.start_buttons:
            b.set_sensitive(ok and not self.busy and getattr(b, "hb_ready", True))

    def _start_button(self, text, note, agent):
        btn = Gtk.Button()
        btn.get_style_context().add_class("hb-start")
        btn.hb_ready = agent is None or agent["ready"]
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        inner.pack_start(label(text), False, False, 0)
        if note:
            inner.pack_start(label(note, "hb-note"), False, False, 0)
        btn.add(inner)
        btn.connect("clicked", lambda *_: self.app.begin(agent))
        self.start_buttons.append(btn)
        return btn

    def _build_ending(self):
        box = self._column()
        box.set_spacing(int(14 * scale_factor()))
        box.pack_start(lockup(self.app.conf, scale=0.55), False, False, 0)
        self.ending_title = label("Time is up. Thanks for building!", "hb-title")
        box.pack_start(self.ending_title, False, False, 6)
        self.code_intro = label("", "hb-body", wrap=True)
        self.qr_image = Gtk.Image()
        self.qr_frame = Gtk.Box()
        self.qr_frame.get_style_context().add_class("hb-qr")
        self.qr_frame.set_halign(Gtk.Align.CENTER)
        self.qr_frame.add(self.qr_image)
        self.url_label = label("", "hb-url", wrap=True)
        self.url_label.set_selectable(False)
        self.code_label = label("", "hb-code")
        self.code_after = label("", "hb-muted", wrap=True)
        self.done_button = Gtk.Button(label="Done")
        self.done_button.get_style_context().add_class("hb-start")
        self.done_button.set_halign(Gtk.Align.CENTER)
        self.done_button.set_size_request(int(280 * scale_factor()), -1)
        self.done_button.connect("clicked", self._done)
        self.ending_countdown = label("", "hb-muted")
        # Shown or hidden per session by _update_ending, not by show_all().
        for w in (self.qr_frame, self.url_label, self.done_button):
            w.set_no_show_all(True)
        self.qr_image.show()
        for w in (self.code_intro, self.qr_frame, self.url_label, self.code_label,
                  self.code_after, self.done_button, self.ending_countdown):
            box.pack_start(w, False, False, 4)
        return box

    def _done(self, *_):
        self.done_button.set_sensitive(False)
        start_unit("hackbox-done.service", lambda ok, msg: False)

    def _build_resetting(self):
        box = self._column()
        box.set_spacing(int(18 * scale_factor()))
        box.pack_start(lockup(self.app.conf, scale=0.55), False, False, 0)
        box.pack_start(label("Getting this station ready for the next builder…", "hb-title"),
                       False, False, 0)
        box.pack_start(label("This takes a few seconds.", "hb-muted"), False, False, 0)
        return box

    def set_busy(self, busy, error=""):
        self.busy = busy
        self._name_changed()
        self.welcome_error.set_text(error)
        self.welcome_error.set_visible(bool(error))

    def show_face(self, face):
        if face != self.face:
            self.face = face
            if face == "ending":
                self.done_button.set_sensitive(True)
        if face == "ending":
            self._update_ending()
        geo = primary_geometry()
        if not self.get_visible():
            self.move(geo.x, geo.y)
            self.resize(geo.width, geo.height)
            self.show_all()
            self.fullscreen()
        # After show_all: a Gtk.Stack ignores a switch to a child that is not
        # visible yet, which left an overlay started mid "ending" (relaunched
        # by the guard) on the welcome face.
        if self.stack.get_visible_child_name() != face:
            self.stack.set_visible_child_name(face)
        # Keep the gate in front: taken back if the attendee switches away.
        if not self.is_active():
            self.set_keep_above(True)
            self.present()

    def _update_ending(self):
        name = read_run("attendee")
        self.ending_title.set_text("Time is up. Thanks for building, %s!" % name.split()[0] if name
                                   else "Time is up. Thanks for building!")
        self.done_button.set_visible(self.app.hub)
        url, hub_code = read_run("hub-url"), read_run("hub-code")
        if url and hub_code and self._show_qr():
            # The hub has the session: the phone page says "Preparing" until the
            # reset archived and the agent uploaded ~/project, a few seconds after Done.
            self.code_intro.set_text("Scan to download your project (valid 7 days):")
            self.url_label.set_text(url)
            self.code_label.set_text(hub_code)
            self.code_after.set_text("Or type this code at %s/code\n"
                                     "Dependencies, build output and secret files such as .env "
                                     "are not kept." % url.split("/d/")[0])
            self.url_label.show()
        else:
            self.qr_frame.hide()
            self.url_label.hide()
            self._local_code()
        until = read_run_int("ending-until")
        if self.app.hub:
            # No countdown with a hub: the screen waits for Done (or staff, from the dashboard).
            self.ending_countdown.set_text("Press Done when you have your project. "
                                           "This machine is wiped for the next person after that.")
        elif until:
            left = max(0, until - int(time.time()))
            self.ending_countdown.set_text("This machine is wiped in %d s." % left)
        else:
            self.ending_countdown.set_text("")

    def _show_qr(self):
        """The hub's QR image, scaled to a third of the screen height. False
        when there is none (hub down at the start of the session)."""
        path = os.path.join(RUN, "qr.png")
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            return False
        if self.qr_shown != mtime:
            try:
                size = int(primary_geometry().height / 3.6)
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size, size, True)
            except GLib.Error:
                return False
            self.qr_image.set_from_pixbuf(pix)
            self.qr_shown = mtime
        self.qr_frame.show()
        return True

    def _local_code(self):
        code = read_run("code")
        hours = as_int(self.app.conf["ARCHIVE_HOURS"], 24)
        if code:
            self.code_intro.set_text("Your ~/project was saved. Your pickup code:")
            self.code_label.set_text(code)
            self.code_after.set_text(
                "Show this code at the help desk within %d hours to get a copy.\n"
                "Dependencies, build output and secret files such as .env are not kept." % hours)
        else:
            self.code_intro.set_text("There was nothing new in ~/project to save.")
            self.code_label.set_text("")
            self.code_after.set_text("")


class Pill(Gtk.Window):
    """The countdown. A POPUP (override-redirect) window: no decorations, no
    taskbar entry, stays above normal and full-screen windows."""

    def __init__(self, app):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.app = app
        self.at_top = True
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual is not None and screen.is_composited():
            self.set_visual(visual)
        self.get_style_context().add_class("hb-pill")
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        box.set_border_width(4)
        # Clicking the time moves the pill between the top and bottom edge,
        # in case it covers something the attendee needs.
        ev = Gtk.EventBox()
        self.time_label = Gtk.Label(label="--:--")
        ev.add(self.time_label)
        ev.connect("button-press-event", self._toggle_edge)
        ev.set_tooltip_text("Click to move")
        end = Gtk.Button(label="End now")
        end.get_style_context().add_class("hb-endbtn")
        end.connect("clicked", self._confirm_end)
        box.pack_start(ev, False, False, 0)
        # With a hub: ask the staff for more time (approved on the dashboard).
        self.more = self.ask_label = None
        if app.hub:
            self.more = Gtk.Button(label="More time")
            self.more.get_style_context().add_class("hb-endbtn")
            self.more.connect("clicked", self._ask_more)
            self.ask_label = Gtk.Label()
            self.ask_label.get_style_context().add_class("hb-ask")
            box.pack_start(self.more, False, False, 0)
            box.pack_start(self.ask_label, False, False, 0)
        box.pack_start(end, False, False, 0)
        self.add(box)
        self.dialog = None
        self.asked_at = 0

    def _ask_more(self, *_):
        self.asked_at = time.time()
        start_unit("hackbox-extend-request.service", lambda ok, msg: False)

    def update_request(self):
        """Mirror /run/hackbox/extend-status (root writes it): pending while
        the staff decide, then the answer for 20 s. No new request for 2
        minutes after a decline (the request script enforces it too)."""
        if self.more is None:
            return
        parts = (read_run("extend-status") or "").split()
        try:
            age = time.time() - os.path.getmtime(os.path.join(RUN, "extend-status"))
        except OSError:
            age = 1e9
        status = parts[0] if parts else ""
        if status == "pending":
            text, can_ask = "asked the staff…", False
        elif time.time() - self.asked_at < 5:
            text, can_ask = "asking…", False
        elif status == "approved" and age < 20:
            text, can_ask = "+%s min" % (parts[1] if len(parts) > 1 else "?"), True
        elif status == "declined" and age < 120:
            text, can_ask = ("not this time" if age < 20 else ""), False
        else:
            text, can_ask = "", True
        if self.ask_label.get_text() != text:
            self.ask_label.set_text(text)
        if self.more.get_sensitive() != can_ask:
            self.more.set_sensitive(can_ask)

    def _toggle_edge(self, *_):
        self.at_top = not self.at_top
        self._place()
        return True

    def _place(self):
        geo = primary_geometry()
        w, h = self.get_size()
        margin = max(4, int(6 * scale_factor()))
        # The bottom edge sits above Cinnamon's panel (about 40 px at scale 1).
        y = geo.y + margin if self.at_top else geo.y + geo.height - h - int(48 * scale_factor())
        self.move(geo.x + (geo.width - w) // 2, y)

    def _confirm_end(self, *_):
        if self.dialog is not None:
            self.dialog.present()
            return
        d = Gtk.MessageDialog(message_type=Gtk.MessageType.QUESTION,
                              buttons=Gtk.ButtonsType.NONE,
                              text="End your session now?")
        d.format_secondary_text("Your ~/project is saved for pickup, then this machine is "
                                "wiped for the next person. This cannot be undone.")
        d.add_button("Keep going", Gtk.ResponseType.CANCEL)
        d.add_button("End now", Gtk.ResponseType.OK)
        d.set_default_response(Gtk.ResponseType.CANCEL)
        d.set_keep_above(True)
        d.set_position(Gtk.WindowPosition.CENTER)
        self.dialog = d

        def on_response(dialog, response):
            dialog.destroy()
            self.dialog = None
            if response == Gtk.ResponseType.OK:
                start_unit("hackbox-reset.service", lambda ok, msg: False)
        d.connect("response", on_response)
        d.show_all()
        d.present()

    def update(self, left):
        self.time_label.set_text("%02d:%02d" % (left // 60, left % 60))
        ctx = self.get_style_context()
        crit, warn = left <= 60, 60 < left <= 300
        for cls, on in (("crit", crit), ("warn", warn)):
            if on and not ctx.has_class(cls):
                ctx.add_class(cls)
            elif not on and ctx.has_class(cls):
                ctx.remove_class(cls)
        if not self.get_visible():
            self.show_all()
        self._place()

    def hide_all(self):
        if self.dialog is not None:
            self.dialog.destroy()
            self.dialog = None
        self.hide()


class Toast(Gtk.Window):
    """Large warning at 5:00 and 1:00 (popups from the notification daemon
    are switched off on these boxes, so the overlay shows its own)."""

    def __init__(self):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.get_style_context().add_class("hb-toast")
        ev = Gtk.EventBox()
        self.text = Gtk.Label()
        self.text.set_justify(Gtk.Justification.CENTER)
        self.text.set_margin_top(18)
        self.text.set_margin_bottom(18)
        self.text.set_margin_start(36)
        self.text.set_margin_end(36)
        ev.add(self.text)
        ev.connect("button-press-event", lambda *_: self.hide() or True)
        self.add(ev)
        self.timer = None

    def flash(self, minutes):
        ctx = self.get_style_context()
        if minutes <= 1:
            ctx.add_class("crit")
            msg = "1 minute left.\nEverything on this machine is wiped at 00:00."
        else:
            ctx.remove_class("crit")
            msg = ("%d minutes left.\nCommit and push your work now." % minutes)
        self.text.set_text(msg)
        self.show_all()
        geo = primary_geometry()
        w, h = self.get_size()
        self.move(geo.x + (geo.width - w) // 2, geo.y + geo.height // 4)
        if self.timer:
            GLib.source_remove(self.timer)
        self.timer = GLib.timeout_add_seconds(12, self._expire)

    def _expire(self):
        self.timer = None
        self.hide()
        return False


