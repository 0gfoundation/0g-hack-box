# hack-box: the attendee's "Ask for more time" (SPEC: docs/superpowers/specs/2026-10-01-session-hub-design.md).
# polkit lets the attendee start this unit and nothing else; the script takes
# no input from the attendee. Installed by setup/70-session.sh. No [Install].
[Unit]
Description=hack-box attendee request: extend

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hackbox-attendee-request extend
TimeoutStartSec=10
